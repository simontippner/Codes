## Headless VMD render of a hole/particle NTO pair from two cube files
## (generated by make_nto_cubes.sh). Renders an isosurface pair for each
## orbital (positive lobe / negative lobe, different colors) overlaid on
## the molecular structure, no GUI/X11 needed.
##
## Usage:
##   vmd -dispdev text -e render_nto.vmd -args hole.cube particle.cube out.tga [isoval]
##
## NOTE: VMD's TachyonInternal renderer writes Targa (.tga) regardless of
## the extension you give it -- convert with tga2png.py afterward, e.g.:
##   python3 tga2png.py out.tga out.png
set holecube [lindex $argv 0]
set partcube [lindex $argv 1]
set outimg   [lindex $argv 2]
set isoval   0.02
if {[llength $argv] > 3} { set isoval [lindex $argv 3] }

mol new $holecube type cube
mol addfile $partcube type cube

display projection orthographic
display depthcue off
color Display Background white
axes location off

mol modstyle 0 0 Lines
mol addrep 0
mol modstyle 1 0 Licorice

# hole density (volume 0): positive lobe red, negative lobe blue
mol addrep 0
mol modstyle 2 0 Isosurface $isoval 0 0 0 1 1
mol modcolor 2 0 ColorID 1

mol addrep 0
mol modstyle 3 0 Isosurface -$isoval 0 0 0 1 1
mol modcolor 3 0 ColorID 0

# particle density (volume 1): positive lobe orange, negative lobe green
mol addrep 0
mol modstyle 4 0 Isosurface $isoval 1 0 0 1 1
mol modcolor 4 0 ColorID 3

mol addrep 0
mol modstyle 5 0 Isosurface -$isoval 1 0 0 1 1
mol modcolor 5 0 ColorID 7

display resetview
render TachyonInternal $outimg
quit
